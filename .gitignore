# Downloaded feed bodies. Rebuilt by `node tools/fetch.js`; never commit them, because a stale
# cache in the repository would silently override a live feed.
.cache/

# Build intermediates and logs. The published list (dist/dns-shield.txt), its statistics
# (dist/stats.json) and the benchmark report (dist/benchmark.txt) ARE committed on purpose: the
# raw subscription URL points at dist/dns-shield.txt.
dist/.compiled.raw
dist/previous.txt
dist/*.log
# The per-feed snapshot: what each feed names when it is compiled on its own. Rebuilt automatically
# whenever the feed set changes (it is cached under the list revision), so it is an intermediate,
# not an artefact.
dist/.perfeed.raw
dist/.perfeed.revision
# Ad-hoc shadow / coverage-gap measurements. Not artefacts either.
dist/.shadow-*.txt
dist/.allfour-open.txt

# One-off diagnostic output from tools/diag-*.js, and the scratch files the live AdGuard Home
# check writes (tools/agh-toggle.js, tools/agh-live-check.js).
diag-*.txt
gap-*.txt
*-console.txt
probe-out.txt
dist/agh-*.json
dist/agh-probe.txt
dist/body-tmp.json
dist/filtering-status.toml

node_modules/
# The lockfile is deliberately not tracked. It solves a problem this repository does not have:
# nobody runs `npm ci` here. CI resolves the compiler with `npm install`, and the only dependency
# is @adguard/hostlist-compiler. A committed lockfile would have to be regenerated by hand after
# every dependency bump, and a stale one is worse than none - which is exactly what happened when
# a CI run committed one that the maintainer's checkout did not have.
package-lock.json
npm-debug.log*
.DS_Store
Thumbs.db
.commit-msg-compliance.txt
